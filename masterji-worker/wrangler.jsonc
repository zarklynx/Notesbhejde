{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "notesbhejde-masterji",
  "main": "index.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [{ "binding": "VOICE_USAGE", "database_name": "masterji-voice-usage", "database_id": "93d96e9b-e6a3-47a4-a863-4713d1844037" }],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173",
    "FIREBASE_PROJECT_ID": "notesbhejde-f5eaf"
  },
  "ratelimits": [{ "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }]
}
