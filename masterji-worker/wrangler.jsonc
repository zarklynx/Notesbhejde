{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "notesbhejde-masterji",
  "main": "index.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": { "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173" },
  "ratelimits": [{ "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }]
}
