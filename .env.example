# Optional: only needed to run your own local AI API.
# Copy to .env.local (ignored by Git). Never prefix this secret with VITE_.
RUNWARE_API_KEY=
RUNWARE_MODEL=openai:gpt@5-nano
# Hosted AI works without an env file. Uncomment for a local API instead.
# VITE_MASTERJI_API_URL=

# Firebase Web app configuration. These are public client settings, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
